<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:padding="16dp">

    <LinearLayout
        android:id="@+id/root_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🎵 FHS &amp; MIUI 毫秒级触觉播放器"
            android:textColor="#FFFFFF"
            android:textSize="21sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/tv_device_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="MIUI 线性马达 RichTap | 10ms 纳秒时钟直驱"
            android:textColor="#00E676"
            android:textSize="12sp"
            android:layout_marginBottom="12dp" />

        <!-- 触觉延迟微调校准器 (解决歌曲精度问题) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#1C2128"
            android:orientation="vertical"
            android:padding="12dp"
            android:layout_marginBottom="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_offset_label"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="⏱️ 触觉对齐补偿: -25 ms"
                    android:textColor="#58A6FF"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="(补偿扬声器缓冲)"
                    android:textColor="#888888"
                    android:textSize="11sp" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="边听歌边微调，让敲击与声音完全合一："
                android:textColor="#AAAAAA"
                android:textSize="11sp"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_offset_minus_20"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:text="-20ms"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:backgroundTint="#21262D"
                    android:layout_marginRight="3dp" />

                <Button
                    android:id="@+id/btn_offset_minus_5"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:text="-5ms"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:backgroundTint="#30363D"
                    android:layout_marginRight="3dp" />

                <Button
                    android:id="@+id/btn_offset_zero"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:text="0ms"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:backgroundTint="#1F6FEB"
                    android:layout_marginRight="3dp" />

                <Button
                    android:id="@+id/btn_offset_plus_5"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:text="+5ms"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:backgroundTint="#30363D"
                    android:layout_marginRight="3dp" />

                <Button
                    android:id="@+id/btn_offset_plus_20"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:text="+20ms"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:backgroundTint="#21262D" />
            </LinearLayout>
        </LinearLayout>

        <!-- 播放控制与波形曲目卡片 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#1E1E1E"
            android:orientation="vertical"
            android:padding="12dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:id="@+id/tv_track_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="DAZBEE - 憧れの残響"
                android:textColor="#00E676"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="2dp" />

            <TextView
                android:id="@+id/tv_track_details"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="1714 个毫秒级起音点 | 纳秒单调时钟驱动"
                android:textColor="#AAAAAA"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="状态：就绪，点击播放体验高精度同步"
            android:textColor="#FFD54F"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <SeekBar
            android:id="@+id/seek_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="1000"
            android:progress="0"
            android:layout_marginBottom="2dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="14dp">

            <TextView
                android:id="@+id/tv_current_time"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="00:00"
                android:textColor="#888888"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tv_total_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="04:28"
                android:textColor="#888888"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- 播放控制按键 -->
        <Button
            android:id="@+id/btn_play_miui_haptics"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="🎵 播放音乐 + 毫秒级清脆触觉 (同步)"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#00C853"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btn_jump_chorus"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="⏩ 快进至副歌高潮鼓点段落 (00:55)"
            android:textSize="13sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#FF6D00"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btn_stop"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="⏹ 停止播放"
            android:textSize="13sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#D50000"
            android:layout_marginBottom="14dp" />

        <!-- 快速测试轻触 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_test_tap_light"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:text="💫 试按极轻脆"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:backgroundTint="#1F6FEB"
                android:layout_marginRight="4dp" />

            <Button
                android:id="@+id/btn_test_tap_normal"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:text="🔘 试按标准脆"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:backgroundTint="#238636"
                android:layout_marginRight="4dp" />

            <Button
                android:id="@+id/btn_test_mesh_heavy"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:text="🪨 试按重低音"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:backgroundTint="#DA3633" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
